# Backend environment variables template (safe to commit)
# Copy this file to .env for local development. Never commit .env with real secrets.

# Server
PORT=3001
NODE_ENV=development

# PostgreSQL
# Local Docker: postgres://postgres:postgres@127.0.0.1:5432/notebook
# Neon (Server / Preview / Production): postgresql://<user>:<password>@<neon-host>/<dbname>?sslmode=require
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/notebook

# Redis
# Local Docker: redis://127.0.0.1:6379
# Upstash (Server / Preview / Production): rediss://default:<password>@<endpoint>.upstash.io:6379
REDIS_URL=redis://127.0.0.1:6379
