# Backend environment variables template (safe to commit)
# Copy this file to .env for local development. Never commit .env with real secrets.

# Server
PORT=3001
NODE_ENV=development

# PostgreSQL
# Local Docker: postgres://postgres:postgres@127.0.0.1:5432/notebook
# Neon (Server / Preview / Production): postgresql://<user>:<password>@<neon-host>/<dbname>?sslmode=require
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/notebook

# Redis
# Local Docker: redis://127.0.0.1:6379
# Upstash (Server / Preview / Production): rediss://default:<password>@<endpoint>.upstash.io:6379
REDIS_URL=redis://127.0.0.1:6379

# Security & URLs
APP_BASE_URL=http://localhost:3000
CSRF_SECRET=replace-with-a-long-random-secret
JWT_SECRET=replace-with-a-long-random-jwt-secret

# Cloudinary (server-side credentials for signed uploads & viewing URLs)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gmail SMTP (use a Google App Password, never your main account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
